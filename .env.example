# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional platform operations account UID; no financial-data access.
PLATFORM_ADMIN_UID=""

# Persistent SQLite path (Docker Compose supplies /app/data/albait.db).
# DATABASE_PATH=/app/data/albait.db

# One-off legacy JSON import only, after an audited backup and validation.
# Leave disabled for normal deployments.
ENABLE_LEGACY_JSON_MIGRATION=false

# Optional public store listing URLs. Empty values show web-app installation help.
# These Vite settings are embedded during build; rebuild after changing them.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
